# Browser calls are proxied through this Next.js app, so the default base URL
# is relative. Keep it as /api/v2 unless you intentionally call the API directly.
NEXT_PUBLIC_BASE_URL=/api/v2

# Server-side rewrite target (Render URL in production).
API_URL=http://localhost:5000

NEXT_PUBLIC_CURRENCY=EGP
NEXT_PUBLIC_CONTACT_EMAIL=hello@nextdemy.app

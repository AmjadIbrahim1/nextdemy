# ---------------------------------------------------------------------------
# Nextdemy API — copy to apps/api/.env for local development.
# Never commit real values.
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# MongoDB Atlas (free M0). MONGODB_URL is accepted for backwards compatibility.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/nextdemy?retryWrites=true&w=majority

# Browser origins allowed to call the API directly. Comma-separate extra ones.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
API_URL=http://localhost:5000
ALLOW_VERCEL_PREVIEWS=false
TRUST_PROXY=1

# Generate strong values, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
UPDATE_PASSWORD_BASE_URL=http://localhost:3000/update-password

# Resend (https://resend.com). In development without a key, email is skipped.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Nextdemy
CONTACT_MAIL=

# Cloudinary is optional for the demo; upload routes return a clear error if unset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FOLDER_NAME=nextdemy
FOLDER_VIDEO=nextdemy/videos

# Payments — mock only. Live mode is intentionally blocked until a reviewed
# provider is implemented.
PAYMENT_MODE=mock
PAYMENT_MOCK_OUTCOME=success # success | failure | cancel
PAYMENT_MOCK_SECRET=
PAYMENT_CURRENCY=EGP

# Use "lax" when the web app proxies /api/v2 (recommended). "none" requires HTTPS.
COOKIE_SAME_SITE=lax
